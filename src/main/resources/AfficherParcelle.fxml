<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.Controllers.AfficherParcelleController"
            fitToWidth="true"
            prefWidth="1100" prefHeight="650"
            style="-fx-background-color: linear-gradient(to bottom, #f8fafc, #ffffff);">

    <content>
        <VBox fx:id="root" spacing="30" alignment="TOP_CENTER"
              style="-fx-padding: 30;">

            <!-- 🌾 Titre principal -->
            <Label text="🌾 Liste des Parcelles"
                   style="-fx-font-size: 30px; -fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>

            <!-- 🔍 Zone de Recherche -->
            <HBox spacing="20" alignment="CENTER" style="-fx-padding: 10 20 0 20;">

                <!-- Recherche -->
                <HBox spacing="10" alignment="CENTER_LEFT"
                      style="-fx-background-color: #ecf0f1; -fx-background-radius: 12; -fx-padding: 8 12;">
                    <Label text="🔍 État :" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <TextField fx:id="searchField"
                               promptText="Ex: bon, moyen..."
                               onKeyReleased="#rechercherParEtat"
                               prefWidth="200"
                               style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-focus-color: #3498db;"/>
                </HBox>

            </HBox>

            <!-- ➕ Bouton Ajouter une Parcelle -->
            <Button text="➕ Ajouter une Parcelle"
                    fx:id="ajouterBtn"
                    onAction="#ajouterParcelle"
                    style="-fx-background-color: linear-gradient(to right, #6a11cb, #2575fc);
                           -fx-text-fill: white;
                           -fx-font-size: 18px;
                           -fx-font-weight: bold;
                           -fx-padding: 12 24;
                           -fx-background-radius: 30;
                           -fx-cursor: hand;"/>

            <!-- 📦 Cartes Dynamiques -->
            <VBox fx:id="cardContainer"
                  spacing="20"
                  alignment="TOP_CENTER"
                  style="-fx-padding: 20 0 0 0;"/>

        </VBox>
    </content>
</ScrollPane>
