<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="chatbotBox" prefHeight="457.0" prefWidth="283.0" spacing="10" style="-fx-background-color: #f2f2f2; -fx-padding: 10;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="Controllers.forum.ChatbotController">

    <TextArea fx:id="chatDisplay" editable="false" prefHeight="400" wrapText="true" />

    <HBox spacing="5">
        <TextField fx:id="userInput" promptText="Écrivez votre message..." HBox.hgrow="ALWAYS" />
        <Button fx:id="sendButton" text="Envoyer" />
    </HBox>

</VBox>
