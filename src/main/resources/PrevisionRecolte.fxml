<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.Controllers.PrevisionRecolteController"
            prefWidth="600" prefHeight="500"
            style="-fx-background-color: linear-gradient(to bottom, #dfe9f3, #ffffff);">

    <children>

        <VBox alignment="CENTER" spacing="25"
              AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20"
              AnchorPane.rightAnchor="20" AnchorPane.bottomAnchor="20"
              style="-fx-background-color: white;
                     -fx-background-radius: 20;
                     -fx-padding: 30;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 4);">

            <!-- Titre -->
            <Label text="🔮 Prévision de Récolte par Culture"
                   style="-fx-font-size: 26px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #2c3e50;"/>

            <!-- Champs de saisie -->
            <TextField fx:id="nomCultureField"
                       promptText="🌾 Nom de la culture (ex : Blé, Tomate...)"
                       style="-fx-background-color: #ecf0f1;
                              -fx-background-radius: 12;
                              -fx-padding: 12;
                              -fx-font-size: 14px;"/>

            <TextField fx:id="superficieField"
                       promptText="📐 Superficie (en hectares)"
                       style="-fx-background-color: #ecf0f1;
                              -fx-background-radius: 12;
                              -fx-padding: 12;
                              -fx-font-size: 14px;"/>

            <TextField fx:id="saisonField"
                       promptText="🗓️ Saison (Printemps, Été, ...)"
                       style="-fx-background-color: #ecf0f1;
                              -fx-background-radius: 12;
                              -fx-padding: 12;
                              -fx-font-size: 14px;"/>

            <!-- Bouton -->
            <Button text="✨ Calculer"
                    onAction="#calculerRecolte"
                    style="-fx-background-color: linear-gradient(to right, #00b09b, #96c93d);
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-font-size: 16px;
                           -fx-background-radius: 30;
                           -fx-padding: 10 20;
                           -fx-cursor: hand;"/>

            <!-- Résultat -->
            <Label fx:id="resultLabel"
                   style="-fx-font-size: 18px;
                          -fx-text-fill: #34495e;
                          -fx-wrap-text: true;
                          -fx-alignment: center;
                          -fx-padding: 10 0 0 0;"/>

        </VBox>

    </children>
</AnchorPane>
