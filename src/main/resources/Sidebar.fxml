<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controlles.Sidebar"
            prefWidth="1100" prefHeight="700"
            style="-fx-background-color: #f4f6f8;">

    <!-- Sidebar -->
    <left>
        <VBox fx:id="sidebar" spacing="20" alignment="TOP_CENTER"
              style="-fx-background-color: #20232a; -fx-padding: 20;" prefWidth="220">

            <Button fx:id="toggleSidebarButton"
                    text="☰"
                    onAction="#toggleSidebar"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 26px; -fx-cursor: hand;" />

            <!-- Conteneur des boutons du menu -->
            <VBox fx:id="menuVBox" spacing="12" alignment="TOP_CENTER">

                <Button text="📦 Produits" onAction="#ouvrirProduits"
                        style="-fx-background-color: #2c2f3a; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 10 20; -fx-background-radius: 10; -fx-cursor: hand; -fx-pref-width: 180;" />

                <Button text="🛒 Commandes" onAction="#ouvrirCommandes"
                        style="-fx-background-color: #2c2f3a; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 10 20; -fx-background-radius: 10; -fx-cursor: hand; -fx-pref-width: 180;" />

                <!-- Bouton Zone -->
                <Button text="🌍 Zones" onAction="#ouvrirZones"
                        style="-fx-background-color: #2c2f3a; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 10 20; -fx-background-radius: 10; -fx-cursor: hand; -fx-pref-width: 180;" />

                <!-- Bouton Grange -->
                <Button text="🏠 Granges" onAction="#ouvrirGranges"
                        style="-fx-background-color: #2c2f3a; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 10 20; -fx-background-radius: 10; -fx-cursor: hand; -fx-pref-width: 180;" />
            </VBox>
        </VBox>
    </left>

    <!-- Centre principal -->
    <center>
        <StackPane fx:id="mainContent" style="-fx-background-color: #f4f6f8;">
            <VBox alignment="CENTER" spacing="10">
                <Label fx:id="dateLabel"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                <Label fx:id="timeLabel"
                       style="-fx-font-size: 26px; -fx-text-fill: #34495e;" />
            </VBox>
        </StackPane>
    </center>

</BorderPane>
