<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.Controllers.ModifierParcelleController"
            prefWidth="600" prefHeight="700"
            style="-fx-background-color: linear-gradient(to bottom right, #dfe9f3, #ffffff);">

    <children>
        <VBox spacing="20" alignment="CENTER" layoutX="30" layoutY="20" prefWidth="540"
              style="-fx-background-color: white;
                     -fx-background-radius: 20;
                     -fx-padding: 30;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);">

            <!-- 📝 Titre -->
            <Label text="✏️ Modifier une Parcelle"
                   style="-fx-font-size: 26px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #2c3e50;"/>

            <!-- 📄 Champs Text -->
            <TextField fx:id="tfId" promptText="ID Parcelle" editable="false" visible="false" managed="false"/>

            <TextField fx:id="tfCultureId" promptText="ID Culture (non modifiable)"
                       style="-fx-background-color: #ecf0f1;
                              -fx-background-radius: 12;
                              -fx-font-size: 14px;
                              -fx-padding: 10;"/>

            <TextField fx:id="tfDescription" promptText="Description"
                       style="-fx-background-color: #ecf0f1;
                              -fx-background-radius: 12;
                              -fx-font-size: 14px;
                              -fx-padding: 10;"/>

            <TextField fx:id="tfZone" promptText="Zone"
                       style="-fx-background-color: #ecf0f1;
                              -fx-background-radius: 12;
                              -fx-font-size: 14px;
                              -fx-padding: 10;"/>

            <HBox spacing="10" alignment="CENTER">
                <TextField fx:id="tfSuperficie" promptText="Superficie (m²)"
                           style="-fx-background-color: #ecf0f1;
                                  -fx-background-radius: 12;
                                  -fx-font-size: 14px;
                                  -fx-padding: 10;"/>
                <TextField fx:id="tfPrix" promptText="Prix de Location"
                           style="-fx-background-color: #ecf0f1;
                                  -fx-background-radius: 12;
                                  -fx-font-size: 14px;
                                  -fx-padding: 10;"/>
            </HBox>

            <!-- 📅 Dates -->
            <HBox spacing="10" alignment="CENTER">
                <DatePicker fx:id="dpDateLocation" promptText="📅 Début Location"
                            style="-fx-background-color: #ecf0f1;
                                   -fx-background-radius: 12;
                                   -fx-font-size: 14px;
                                   -fx-padding: 8;"/>
                <DatePicker fx:id="dpDateFinLocation" promptText="📅 Fin Location"
                            style="-fx-background-color: #ecf0f1;
                                   -fx-background-radius: 12;
                                   -fx-font-size: 14px;
                                   -fx-padding: 8;"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER">
                <TextField fx:id="tfEtat" promptText="État"
                           style="-fx-background-color: #ecf0f1;
                                  -fx-background-radius: 12;
                                  -fx-font-size: 14px;
                                  -fx-padding: 10;"/>
                <TextField fx:id="tfTypeSol" promptText="Type de Sol"
                           style="-fx-background-color: #ecf0f1;
                                  -fx-background-radius: 12;
                                  -fx-font-size: 14px;
                                  -fx-padding: 10;"/>
            </HBox>

            <!-- 🌄 Image -->
            <HBox spacing="10" alignment="CENTER">
                <TextField fx:id="tfImage" promptText="URL de l'image"
                           style="-fx-background-color: #ecf0f1;
                                  -fx-background-radius: 12;
                                  -fx-font-size: 14px;
                                  -fx-padding: 10;"/>
                <Button text="📂" onAction="#parcourirImage"
                        style="-fx-background-color: #3498db;
                               -fx-text-fill: white;
                               -fx-background-radius: 12;
                               -fx-font-size: 16px;
                               -fx-cursor: hand;"/>
            </HBox>

            <!-- 🎛️ Boutons -->
            <HBox spacing="20" alignment="CENTER">
                <Button text="⬅ Retour" onAction="#retourAfficherParcelle"
                        style="-fx-background-color: #7b8d93;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 20;
                               -fx-font-size: 14px;
                               -fx-padding: 8 20;
                               -fx-cursor: hand;"/>

                <Button text="💾 Enregistrer"
                        onMouseClicked="#modifierParcelle"
                        style="-fx-background-color: linear-gradient(to right, #43cea2, #185a9d);
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 20;
                               -fx-font-size: 16px;
                               -fx-padding: 8 20;
                               -fx-cursor: hand;"/>
            </HBox>

        </VBox>
    </children>
</AnchorPane>
