<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controlles.ProductiviteChartZone"
      stylesheets="@ProductiviteChartZone.css"
      spacing="20"
      style="-fx-padding: 20;">

    <BarChart fx:id="productiviteChart"
              title="📊 Productivité des Granges"
              styleClass="productivity-chart">
        <xAxis>
            <CategoryAxis label="Nom des Granges" styleClass="axis-label"/>
        </xAxis>
        <yAxis>
            <NumberAxis label="Niveau de Productivité (kg/m²)" styleClass="axis-label"/>
        </yAxis>
    </BarChart>
</VBox>