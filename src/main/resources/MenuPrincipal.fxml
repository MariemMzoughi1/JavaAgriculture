<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controllers.MenuPrincipalController"
            prefWidth="800" prefHeight="600">

    <!-- Barre latérale gauche -->
    <left>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <Button text="Culture" onAction="#ouvrirCulture"
                    style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-pref-width: 150;" />
            <Button text="Parcelle" onAction="#ouvrirParcelle"
                    style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-pref-width: 150;" />
            <Button text="➕ Ajouter une machine" onAction="#handleAddMachine"
                    style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-pref-width: 150;" />
            <Button text="📋 Machines" onAction="#handleMachines"  style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-pref-width: 150;" />
            <Button text="📅 Réservations" onAction="#handleReservation"  style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-pref-width: 150;" />
            <Button text="💬 Forum" onAction="#handleForum"  style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-pref-width: 150;" />
            <Button text="🧺 Produits" onAction="#handleProduit"  style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-pref-width: 150;" />
            <Button text="🔓 Logout" onAction="#handleLogout"  style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-pref-width: 150;" />

        </VBox>
    </left>

    <!-- Contenu central -->

        <center>
            <StackPane fx:id="mainContent" style="-fx-background-color: #ecf0f1;">
                <VBox alignment="CENTER" spacing="10">
                    <Label fx:id="dateLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                    <Label fx:id="timeLabel" style="-fx-font-size: 24px; -fx-text-fill: #2c3e50;" />
                </VBox>
            </StackPane>
        </center>

</BorderPane>
