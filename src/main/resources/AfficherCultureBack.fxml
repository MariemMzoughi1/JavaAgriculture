<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.Controllers.AfficherCultureBackController"
            prefWidth="1000" prefHeight="600"
            style="-fx-background-color: linear-gradient(to right, #f0f2f5, #e6f0ff);">

    <VBox spacing="20" alignment="TOP_CENTER"
          AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.bottomAnchor="20">

        <!-- 🏷️ Titre -->
        <Label text="🌿 Liste des Cultures"
               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

        <!-- 🧾 Conteneur Table -->
        <VBox spacing="15"
              style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-color: #dcdde1; -fx-border-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0.3, 0.3, 0);">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>

            <!-- 📋 TableView des Cultures -->
            <TableView fx:id="cultureTable" prefHeight="450"
                       style="-fx-font-size: 14px; -fx-table-cell-border-color: transparent;">

                <columns>
                    <TableColumn fx:id="imageCol" text="Image" prefWidth="100"
                                 style="-fx-alignment: CENTER;"/>

                    <TableColumn fx:id="idCol" text="ID" prefWidth="60"
                                 style="-fx-alignment: CENTER;"/>

                    <TableColumn fx:id="nomCol" text="Nom" prefWidth="150"
                                 style="-fx-alignment: CENTER-LEFT;"/>

                    <TableColumn fx:id="categorieCol" text="Catégorie" prefWidth="150"
                                 style="-fx-alignment: CENTER-LEFT;"/>

                    <TableColumn fx:id="quantiteCol" text="Quantité" prefWidth="120"
                                 style="-fx-alignment: CENTER;"/>

                    <TableColumn fx:id="saisonCol" text="Saison" prefWidth="120"
                                 style="-fx-alignment: CENTER;"/>

                    <TableColumn fx:id="actionCol" text="Actions" prefWidth="220"
                                 style="-fx-alignment: CENTER;"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</AnchorPane>
