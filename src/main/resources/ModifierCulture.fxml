<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.Controllers.ModifierCultureController"
            prefWidth="600" prefHeight="680"
            style="-fx-background-color: linear-gradient(to bottom, #e0eafc, #cfdef3);">

    <children>

        <VBox spacing="20" alignment="CENTER"
              layoutX="30" layoutY="20" prefWidth="540"
              style="-fx-background-color: white;
                     -fx-background-radius: 20;
                     -fx-padding: 30;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);">

            <!-- 📝 Titre -->
            <Label text="✏️ Modifier une Culture"
                   style="-fx-font-size: 26px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #2c3e50;"/>

            <!-- 📄 Champs de saisie -->
            <TextField fx:id="tfId" promptText="ID (non modifiable)" editable="false"
                       style="-fx-background-color: #ecf0f1;
                              -fx-background-radius: 12;
                              -fx-font-size: 14px;
                              -fx-padding: 10;"/>

            <TextField fx:id="tfNom" promptText="Nom de la Culture"
                       style="-fx-background-color: #ecf0f1;
                              -fx-background-radius: 12;
                              -fx-font-size: 14px;
                              -fx-padding: 10;"/>

            <TextField fx:id="tfDescription" promptText="Description"
                       style="-fx-background-color: #ecf0f1;
                              -fx-background-radius: 12;
                              -fx-font-size: 14px;
                              -fx-padding: 10;"/>

            <!-- 🌄 Image -->
            <HBox spacing="10" alignment="CENTER">
                <TextField fx:id="tfImage" promptText="Lien de l'image"
                           style="-fx-background-color: #ecf0f1;
                                  -fx-background-radius: 12;
                                  -fx-font-size: 14px;
                                  -fx-padding: 10;"/>
                <Button text="📂" onAction="#parcourirImage"
                        style="-fx-background-color: #2196F3;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 12;
                               -fx-font-size: 16px;
                               -fx-cursor: hand;"/>
            </HBox>

            <!-- 📅 Dates -->
            <HBox spacing="10" alignment="CENTER">
                <DatePicker fx:id="dpDatePlantation" promptText="📅 Plantation"
                            style="-fx-background-color: #ecf0f1;
                                   -fx-background-radius: 12;
                                   -fx-font-size: 14px;
                                   -fx-padding: 8;"/>
                <DatePicker fx:id="dpDateRecolte" promptText="📅 Récolte"
                            style="-fx-background-color: #ecf0f1;
                                   -fx-background-radius: 12;
                                   -fx-font-size: 14px;
                                   -fx-padding: 8;"/>
            </HBox>

            <!-- 🛠 Autres champs -->
            <TextField fx:id="tfSaison" promptText="Saison (printemps, été...)"
                       style="-fx-background-color: #ecf0f1;
                              -fx-background-radius: 12;
                              -fx-font-size: 14px;
                              -fx-padding: 10;"/>

            <TextField fx:id="tfQuantite" promptText="Quantité (en kg)"
                       style="-fx-background-color: #ecf0f1;
                              -fx-background-radius: 12;
                              -fx-font-size: 14px;
                              -fx-padding: 10;"/>

            <TextField fx:id="tfCategorie" promptText="Catégorie"
                       style="-fx-background-color: #ecf0f1;
                              -fx-background-radius: 12;
                              -fx-font-size: 14px;
                              -fx-padding: 10;"/>

            <!-- 🎛️ Boutons -->
            <HBox spacing="20" alignment="CENTER">
                <Button text="⬅ Retour"
                        onAction="#retourAfficherParcelle"
                        style="-fx-background-color: #7b8d93;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 20;
                               -fx-font-size: 14px;
                               -fx-padding: 8 20;
                               -fx-cursor: hand;"/>

                <Button text="💾 Enregistrer"
                        onAction="#modifierCulture"
                        style="-fx-background-color: linear-gradient(to right, #43cea2, #185a9d);
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 20;
                               -fx-font-size: 16px;
                               -fx-padding: 8 20;
                               -fx-cursor: hand;"/>
            </HBox>

        </VBox>

    </children>
</AnchorPane>
