<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controles.AdminDashboardViewController"
      prefWidth="600" prefHeight="800"
      alignment="TOP_CENTER" spacing="20"
      style="-fx-background-color: #f9f9f9; -fx-padding: 40;">

    <Label text="Admin Dashboard"
           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

    <Separator orientation="HORIZONTAL" prefWidth="500"/>
    <!--  go to here C:\Projectjava\src\main\resources\com\example\projectjava\user-list-view.fxml-->
    <Button text="🛒 Produits Disponibles"
            onAction="#handleAfficherProduitsDisponibles"
            style="-fx-font-size: 16px; -fx-pref-width: 300; -fx-background-color: #16a085; -fx-text-fill: white;" />

    <Button text="📦 Commandes"
            onAction="#handleAfficherCommandes"
            style="-fx-font-size: 16px; -fx-pref-width: 300; -fx-background-color: #c0392b; -fx-text-fill: white;" />

</VBox>