<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.Controllers.AfficherParcelleBackController"
            prefWidth="1000" prefHeight="600"
            style="-fx-background-color: linear-gradient(to right, #f8f9fa, #e9efff);">

    <VBox spacing="20" alignment="TOP_CENTER"
          AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.bottomAnchor="20">

        <!-- 🏷️ Titre -->
        <Label text="🌱 Liste des Parcelles"
               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

        <!-- 🧾 Conteneur Table -->
        <VBox spacing="15"
              style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-color: #dcdde1; -fx-border-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0.3, 0.3, 0);">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- 📋 TableView des Parcelles -->
            <TableView fx:id="parcelleTable" prefHeight="450"
                       style="-fx-font-size: 14px; -fx-table-cell-border-color: transparent;">

                <columns>
                    <TableColumn fx:id="imageCol" text="Image" prefWidth="100"
                                 style="-fx-alignment: CENTER;"/>

                    <TableColumn fx:id="idCol" text="ID" prefWidth="50"
                                 style="-fx-alignment: CENTER;"/>

                    <TableColumn fx:id="zoneCol" text="Zone" prefWidth="120"
                                 style="-fx-alignment: CENTER-LEFT;"/>

                    <TableColumn fx:id="descriptionCol" text="Description" prefWidth="150"
                                 style="-fx-alignment: CENTER-LEFT;"/>

                    <TableColumn fx:id="superficieCol" text="Superficie (m²)" prefWidth="120"
                                 style="-fx-alignment: CENTER;"/>

                    <TableColumn fx:id="etatCol" text="État" prefWidth="100"
                                 style="-fx-alignment: CENTER;"/>

                    <TableColumn fx:id="typeSolCol" text="Type de Sol" prefWidth="130"
                                 style="-fx-alignment: CENTER;"/>

                    <TableColumn fx:id="actionCol" text="Actions" prefWidth="220"
                                 style="-fx-alignment: CENTER;"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</AnchorPane>
