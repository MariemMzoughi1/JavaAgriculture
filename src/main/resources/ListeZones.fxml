<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="500.0" prefWidth="700.0"
            style="-fx-background-color: #e8f5e9;"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controlles.ListeZones"
            stylesheets="@ListeZones.css">

    <!-- 🌿 Titre -->
    <Text layoutX="230.0" layoutY="30.0"
          style="-fx-font-size: 24px; -fx-fill: #2e7d32;"
          text="🌿 Liste des Zones 🌿" />

    <!-- 🔍 Recherche -->
    <TextField fx:id="searchField"
               layoutX="35.0" layoutY="60.0"
               prefWidth="630.0"
               promptText="Rechercher une zone..."
               onKeyReleased="#rechercherZones" />

    <!-- 📋 ScrollPane avec les cards -->
    <ScrollPane layoutX="35.0" layoutY="137.0"
                prefHeight="310.0" prefWidth="630.0"
                style="-fx-background: transparent;">
        <content>
            <VBox fx:id="zoneContainer"
                  spacing="15"
                  alignment="TOP_CENTER"
                  styleClass="card-container">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>
            </VBox>
        </content>
    </ScrollPane>

    <!-- 🔃 Tri -->
    <Button fx:id="btnTriNom"
            layoutX="32.0" layoutY="96.0"
            onAction="#trierParNom"
            style="-fx-background-color: #42a5f5; -fx-text-fill: white; -fx-font-weight: bold;"
            text="Trier par Nom" />
    <Button fx:id="btnTriSuperficie"
            layoutX="141.0" layoutY="96.0"
            onAction="#trierParSuperficie"
            style="-fx-background-color: #42a5f5; -fx-text-fill: white; -fx-font-weight: bold;"
            text="Trier par Superficie" />

    <!-- ➕ Boutons bas -->
    <Button fx:id="ajouterBtn"
            layoutX="44.0" layoutY="461.0"
            onAction="#ajouterZone"
            style="-fx-background-color: #66bb6a; -fx-text-fill: white; -fx-font-weight: bold;"
            text="Ajouter" />
    <Button fx:id="retourBtn"
            layoutX="112.0" layoutY="461.0"
            onAction="#retourAccueil"
            style="-fx-background-color: #8d6e63; -fx-text-fill: white; -fx-font-weight: bold;"
            text="Accueil" />
    <Button layoutX="460.0" layoutY="461.0"
            onAction="#exporterCSV"
            style="-fx-background-color: #f5d505; -fx-text-fill: white;"
            text="Exporter en CSV" />
    <Button layoutX="574.0" layoutY="461.0"
            onAction="#exporterPDF"
            style="-fx-background-color: #f4022f; -fx-text-fill: white; -fx-font-weight: bold;"
            text="Exporter PDF" />

</AnchorPane>
