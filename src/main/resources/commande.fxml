<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controles.CommandeController"
            prefWidth="900" prefHeight="700"
            style="-fx-background-color: linear-gradient(to bottom right, #f4f4f9, #ffffff);">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="20" layoutX="20" layoutY="20" prefWidth="860">
        <Button fx:id="btnRetour"
                text="↩ Retour"
                onAction="#retourAfficherProduit"
                style="-fx-background-color: #3498db;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-padding: 8 16;
                       -fx-background-radius: 18;
                       -fx-font-size: 13px;
                       -fx-cursor: hand;" />

        <Label fx:id="labelTitre"
               text="📦 Liste des Produits"
               style="-fx-font-size: 24px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #2c3e50;" />

        <Region HBox.hgrow="ALWAYS" />

        <Button fx:id="btnPanier"
                text="🛒 Panier"
                onAction="#ouvrirPanier"
                style="-fx-background-color: #FF5722;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;
                       -fx-font-weight: bold;
                       -fx-padding: 8 18;
                       -fx-background-radius: 20;
                       -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.25), 4, 0.2, 0, 2);" />
    </HBox>

    <!-- Contenu produits -->
    <ScrollPane layoutX="20" layoutY="80" prefHeight="560" prefWidth="860"
                style="-fx-background-color: transparent; -fx-border-color: transparent;">
        <FlowPane fx:id="produitsContainer"
                  hgap="20" vgap="20">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <prefWrapLength>800</prefWrapLength>
            <style>-fx-alignment: center;</style>
        </FlowPane>


    </ScrollPane>

    <!-- Message panier -->
    <Label fx:id="panierMessage"
           layoutX="20"
           layoutY="660"
           text="Panier vide !"
           visible="false"
           style="-fx-font-size: 15px;
                  -fx-text-fill: #FF5722;
                  -fx-font-weight: bold;" />
</AnchorPane>
