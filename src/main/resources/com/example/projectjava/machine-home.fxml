<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="700" prefWidth="1000" styleClass="main-background" stylesheets="@homes.css" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.MachineHomeController">

    <HBox spacing="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <!-- Barre latérale -->
        <VBox fx:id="sidebar" spacing="12" styleClass="sidebar">
            <Label styleClass="sidebar-title" text="🌿 Tableau de bord" />

            <Button onAction="#handleAddMachine" styleClass="sidebar-button" text="➕ Ajouter une machine" />
            <Button onAction="#handleListMachines" styleClass="sidebar-button" text="📋 Liste des machines" />
            <Button onAction="#handleReservation" styleClass="sidebar-button" text="📅 Réservations" />
            <Button onAction="#handleOpenMachineReservationList" styleClass="sidebar-button" text="🔎 Réserver une machine disponible" />

            <Separator />

            <Button onAction="#handleForum" styleClass="sidebar-button" text="💬 Forum" />
            <Button onAction="#handleAccueil" styleClass="sidebar-button" text="🏠 Zone / Grange" />
            <Button onAction="#handleProduits" styleClass="sidebar-button" text=" Produits" />
            <Button onAction="#handleCommande" styleClass="sidebar-button" text=" Commandes" />

            <Separator />

            <Button onAction="#handleCulture" styleClass="sidebar-button" text="🌾 Cultures" />
            <Button onAction="#handleParcelle" styleClass="sidebar-button" text="🗺️ Parcelles" />

            <Separator />

            <Button onAction="#handleEditProfile" styleClass="sidebar-button" text="👤 Modifier Profil" />
            <Button onAction="#handleLogout" styleClass="sidebar-button" text="🔓 Déconnexion" />
        </VBox>

        <!-- Zone principale -->
        <AnchorPane fx:id="mainContentArea" styleClass="main-content" HBox.hgrow="ALWAYS">
            <VBox fx:id="newsContainer" spacing="12" style="-fx-padding: 10 0 0 10;">
                <Label styleClass="news-title" text="📰 Dernières Actualités" />
                <ScrollPane fitToWidth="true" prefHeight="600">
                    <VBox fx:id="newsList" spacing="15" styleClass="news-list" />
               <VBox.margin>
                  <Insets />
               </VBox.margin>
                </ScrollPane>
            </VBox>
        </AnchorPane>
    </HBox>
</AnchorPane>
