<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="900.0" prefWidth="1200.0" style="-fx-background-color: linear-gradient(to bottom, #eef9e6, #d2f0c0);" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ReservationViewController">

    <VBox spacing="20" AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.topAnchor="20">

        <!-- 🔙 Bouton retour -->
        <Button onAction="#handleBack" style="-fx-background-color: #7f8c8d;                        -fx-text-fill: white;                        -fx-font-weight: bold;                        -fx-padding: 6 20;                        -fx-background-radius: 8;                        -fx-font-size: 13px;" text="🔙 Retour à l'accueil" />

        <!-- 🌦️ Météo (placée en haut) -->
        <Label fx:id="weatherLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2e5e1a;" text="Météo actuelle..." />

        <!-- Partie formulaire + carte -->
        <HBox alignment="CENTER" spacing="50">

            <!-- 📄 Formulaire réservation -->
            <VBox alignment="TOP_CENTER" maxWidth="400" prefHeight="420.0" prefWidth="350.0" spacing="14" style="-fx-background-color: #ffffff; -fx-padding: 25;                          -fx-background-radius: 12;                          -fx-effect: dropshadow(gaussian, rgba(160,200,110,0.25), 10, 0.1, 0, 4);">

                <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2e5e1a;" text="🌾 Réserver une Machine" />

                <Label style="-fx-font-weight: bold; -fx-text-fill: #4b6d2c;" text="🚜 Machine disponible :" />
                <ComboBox fx:id="machineComboBox" promptText="Choisir une machine" style="-fx-pref-width: 300; -fx-background-radius: 6;" />

                <Label style="-fx-font-weight: bold; -fx-text-fill: #4b6d2c;" text="📅 Date de début :" />
                <DatePicker fx:id="startDatePicker" style="-fx-pref-width: 300; -fx-background-radius: 6;" />

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label style="-fx-text-fill: #4b6d2c;" text="🕒 Heure de début :" />
                    <Spinner fx:id="startHourSpinner" prefWidth="60" />
                    <Label text=":" />
                    <Spinner fx:id="startMinuteSpinner" prefWidth="60" />
                </HBox>

                <Label style="-fx-font-weight: bold; -fx-text-fill: #4b6d2c;" text="📆 Date de fin :" />
                <DatePicker fx:id="endDatePicker" style="-fx-pref-width: 300; -fx-background-radius: 6;" />

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label style="-fx-text-fill: #4b6d2c;" text="🕒 Heure de fin :" />
                    <Spinner fx:id="endHourSpinner" prefWidth="60" />
                    <Label text=":" />
                    <Spinner fx:id="endMinuteSpinner" prefWidth="60" />
                </HBox>

                <Button fx:id="reserveButton" onAction="#handleReserve" style="-fx-background-color: #6bbf59; -fx-text-fill: white;                                -fx-font-weight: bold; -fx-font-size: 14px;                                -fx-padding: 10 24; -fx-background-radius: 8;" text="🌱 Réserver" />

                <Label fx:id="messageLabel" style="-fx-text-fill: #c0392b; -fx-font-weight: bold; -fx-font-size: 13px;" text="" wrapText="true" />
            </VBox>

            <!-- 🖼️ Carte machine -->
            <VBox fx:id="machineCard" alignment="CENTER" maxWidth="400" spacing="12" style="-fx-background-color: #f6fff0; -fx-padding: 20;                          -fx-background-radius: 12;                          -fx-effect: dropshadow(gaussian, rgba(150,200,100,0.2), 8, 0.1, 0, 3);" visible="false">

                <ImageView fx:id="machineImage" fitHeight="180" fitWidth="250" preserveRatio="true" style="-fx-effect: dropshadow(gaussian, #cce5b0, 4, 0.1, 0, 2);" />

                <Label fx:id="machineName" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2e5e1a;" />
                <Label fx:id="machineType" style="-fx-text-fill: #4b6d2c;" />
                <Label fx:id="machineEtat" style="-fx-text-fill: #6e8e3e;" />
                <Label fx:id="machinePrix" style="-fx-text-fill: #28a745; -fx-font-weight: bold;" />
            </VBox>
        </HBox>

        <!-- 💬 Zone de chat (en bas) -->
        <VBox alignment="CENTER" spacing="15" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 12;">

            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2e5e1a;" text="🤖 Assistant agricole - Chatbot" />

            <TextArea fx:id="chatArea" editable="false" prefHeight="70" prefWidth="500" style="-fx-background-color: #f9f9f9; -fx-font-size: 15px;" wrapText="true" />

            <HBox alignment="CENTER" spacing="10">
                <TextField fx:id="userInput" prefWidth="600" promptText="Posez votre question..." />
                <Button onAction="#handleSend" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Envoyer" />
            </HBox>

            <HBox alignment="CENTER" spacing="15">
                <Button onAction="#handleQuickTypes" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Types de machines" />
                <Button onAction="#handleQuickPrice" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Prix location 2025" />
                <Button onAction="#handleQuickMaintenance" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Entretien machine" />
                <Button onAction="#handleQuickReservation" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Réserver une semaine" />
            </HBox>

        </VBox>

    </VBox>

</AnchorPane>
