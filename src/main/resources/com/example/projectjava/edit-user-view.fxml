<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.EditUserController"
            prefWidth="400" prefHeight="300"
            style="-fx-background-color: #f9f9f9;">

    <VBox spacing="15" alignment="CENTER" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">
        <Label text="Modifier Utilisateur" style="-fx-font-size: 20px; -fx-font-weight: bold;" />

        <TextField fx:id="emailField" promptText="Email" />
        <PasswordField fx:id="passwordField" promptText="Password" />

        <Button text="✅ Enregistrer" onAction="#handleSaveUser" style="-fx-background-color: #27ae60; -fx-text-fill: white;" />
    </VBox>

</AnchorPane>
