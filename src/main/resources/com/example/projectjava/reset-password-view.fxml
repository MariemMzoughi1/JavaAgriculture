<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.ResetPasswordController"
      spacing="15"
      prefHeight="600" prefWidth="800"
      alignment="CENTER"
      style="-fx-padding: 40; -fx-background-color: #fefefe; -fx-font-family: 'Segoe UI';">

    <Label text="🔐 Réinitialiser le mot de passe" style="-fx-font-size: 20px; -fx-text-fill: #4A7C59;" />

    <TextField fx:id="emailField" promptText="Email" style="-fx-pref-width: 250;" />
    <TextField fx:id="tokenField" promptText="Code de vérification reçu" style="-fx-pref-width: 250;" />
    <PasswordField fx:id="newPasswordField" promptText="Nouveau mot de passe" style="-fx-pref-width: 250;" />
    <PasswordField fx:id="confirmPasswordField" promptText="Confirmer mot de passe" style="-fx-pref-width: 250;" />

    <Label fx:id="messageLabel" text="" style="-fx-text-fill: red;" wrapText="true" />

    <Button text="🔁 Réinitialiser" onAction="#handleResetPassword"
            style="-fx-background-color: #7BB661; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 250;" />
</VBox>

