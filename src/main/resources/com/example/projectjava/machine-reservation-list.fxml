<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.MachineReservationListController"
            prefWidth="1000.0" prefHeight="700.0"
            style="-fx-background-color: linear-gradient(to bottom, #f1ffe7, #d6f2c0);">

    <VBox spacing="20" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.bottomAnchor="20">

        <!-- 🔙 Bouton retour -->
        <Button text="🔙 Retour à l'accueil"
                onAction="#handleBack"
                style="-fx-background-color: #7f8c8d;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-padding: 6 20;
                       -fx-background-radius: 8;
                       -fx-font-size: 13px;" />

        <Label text="📋 Liste des machines disponibles"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2e5e1a;" />

        <ScrollPane fitToWidth="true" fitToHeight="true">
            <TilePane fx:id="machineTilePane" hgap="20" vgap="20" prefColumns="3"
                      style="-fx-padding: 20; -fx-background-color: transparent;" />
        </ScrollPane>

    </VBox>
</AnchorPane>
