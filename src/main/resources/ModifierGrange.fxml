<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" alignment="CENTER" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="Controlles.ModifierGrange">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Modifier Grange" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TextField fx:id="typeGrangeField" promptText="Type de grange"/>
    <TextField fx:id="capaciteField" promptText="Capacité"/>

    <ComboBox fx:id="zoneComboBox" promptText="Sélectionnez une zone"/>

    <Label fx:id="messageErreur" style="-fx-text-fill: red;"/>

    <HBox spacing="10">
        <Button text="Modifier" onAction="#modifierGrange"/>
        <Button text="Annuler" onAction="#fermerFenetre"/>
    </HBox>
</VBox>
