<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="750.0" style="-fx-background-color: linear-gradient(to bottom right, #eef1f5, #ffffff);" stylesheets="@styleaffiche.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controles.AfficherProduit">

    <VBox fx:id="container" spacing="20" style="-fx-background-color: white;                  -fx-background-radius: 18;                  -fx-padding: 30;                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 15, 0.3, 0, 5);" AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="30" AnchorPane.rightAnchor="30" AnchorPane.topAnchor="20">

        <!-- Titre + boutons -->
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Label fx:id="labelTitre" style="-fx-font-size: 24px;                           -fx-font-weight: bold;                           -fx-text-fill: #2d3436;" text="📦 Liste des Produits" />

            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="btnAjouter" onAction="#ajouterProduit" prefHeight="36" prefWidth="180" styleClass="btn-ajouter" text="➕ Ajouter un produit" />

            <Button fx:id="btnVoirCommandes" onAction="#ouvrirCommandes" prefHeight="36" prefWidth="180" style="-fx-background-color: #00b894;                            -fx-text-fill: white;                            -fx-font-size: 13px;                            -fx-background-radius: 22;                            -fx-font-weight: bold;                            -fx-cursor: hand;" text="🧾 Voir les commandes" />
        </HBox>

        <!-- Table des produits -->
        <TableView fx:id="tableProduits" style="-fx-background-radius: 12;                           -fx-border-color: #dfe6e9;                           -fx-border-radius: 12;" styleClass="modern-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNom" prefWidth="148.80000114440918" style="-fx-alignment: CENTER-LEFT;" text="Nom" />

                <TableColumn fx:id="colDate" prefWidth="178.3999786376953" style="-fx-alignment: CENTER;" text="Date d'ajout" />
            </columns>
        </TableView>
    </VBox>
</AnchorPane>
