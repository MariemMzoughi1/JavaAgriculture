<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="Controllers.AdminForum.AdminDetailsForum"
      prefHeight="700" prefWidth="1200"
      stylesheets="@/details_forum.css">

    <BorderPane>
        <left>
            <fx:include source="MenuPrincipal.fxml"/>
        </left>

        <center>
            <ScrollPane fitToWidth="true" styleClass="scroll-pane">
                <VBox styleClass="main-container" spacing="20">
                    <!-- En-tête -->
                    <VBox styleClass="header-box" spacing="5">
                        <Label fx:id="titreLabel" styleClass="titre-label"/>
                        <Label fx:id="auteurDateLabel" styleClass="meta-label"/>
                    </VBox>

                    <!-- Contenu principal -->
                    <VBox spacing="15" styleClass="content-box">
                        <StackPane styleClass="image-container">
                            <ImageView fx:id="imageView" styleClass="post-image"
                                        preserveRatio="true"/>
                        </StackPane>

                        <TextArea fx:id="contenuArea" styleClass="contenu-area"
                                  editable="false" wrapText="true"/>

                        <!-- Interactions -->
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Button fx:id="likeBtn" styleClass="like-button" onAction="#handleLike"/>
                            <Button fx:id="dislikeBtn" styleClass="dislike-button" onAction="#handleDislike"/>
                            <Button text="Traduire" styleClass="action-button"
                                    onAction="#traduireContenuPost"/>
                        </HBox>
                    </VBox>

                    <!-- Actions -->
                    <HBox spacing="20" alignment="CENTER">
                        <Button text="Retour" styleClass="nav-button" onAction="#handleRetour"/>
                        <Button fx:id="modifierBtn" text="Modifier" styleClass="primary-button"
                                onAction="#handleModifier"/>
                    </HBox>

                    <!-- Section commentaires -->
                    <VBox spacing="15" styleClass="comment-section">
                        <Label text="Commentaires" styleClass="section-title"/>

                        <HBox spacing="10" styleClass="comment-input-box">
                            <TextField fx:id="champCommentaire" promptText="Écrivez un commentaire..."
                                       styleClass="comment-field" HBox.hgrow="ALWAYS"/>
                            <Button text="Publier" styleClass="primary-button"
                                    onAction="#ajouterCommentaire"/>
                        </HBox>

                        <VBox fx:id="commentairesBox" spacing="10"/>
                    </VBox>
                </VBox>
            </ScrollPane>
        </center>
    </BorderPane>
</VBox>