<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.DropShadow?>

<VBox xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1"
      fx:controller="controles.AfficherInfoProduit"
      spacing="20" alignment="TOP_CENTER"
      prefHeight="600" prefWidth="520"
      stylesheets="@style2.css"
      styleClass="main-container">

    <!-- Titre -->
    <Label text="📝 Détails du Produit" styleClass="title-label"/>

    <!-- Informations Produit -->
    <GridPane hgap="20" vgap="20" styleClass="info-grid">
        <columnConstraints>
            <ColumnConstraints percentWidth="40"/>
            <ColumnConstraints percentWidth="60"/>
        </columnConstraints>

        <!-- Ligne 1 -->
        <Label text="ID :" styleClass="label-bold" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="labelId" styleClass="label-value" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <!-- Ligne 2 -->
        <Label text="Nom :" styleClass="label-bold" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label fx:id="labelNom" styleClass="label-value" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <!-- Ligne 3 -->
        <Label text="Date d'ajout :" styleClass="label-bold" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Label fx:id="labelDate" styleClass="label-value" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <!-- Ligne 4 -->
        <Label text="Description :" styleClass="label-bold" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <Label fx:id="labelDescription" wrapText="true" styleClass="label-value" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <!-- Ligne 5 -->
        <Label text="Catégorie :" styleClass="label-bold" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <Label fx:id="labelCategorie" styleClass="label-value" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <!-- Ligne 6 -->
        <Label text="Prix Unitaire :" styleClass="label-bold" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <Label fx:id="labelPrix" styleClass="label-value" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <!-- Ligne 7 -->
        <Label text="Quantité en Stock :" styleClass="label-bold" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <Label fx:id="labelQuantiteStock" styleClass="label-value" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        <!-- Ligne 8 -->
        <Label text="ID Agriculteur :" styleClass="label-bold" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <Label fx:id="labelAgriculteurId" styleClass="label-value" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
    </GridPane>

    <!-- Boutons -->
    <HBox spacing="15" alignment="CENTER">
        <Button fx:id="btnClose" onAction="#onClose" text="Fermer" styleClass="btn-secondary"/>
        <Button fx:id="btnEdit" onAction="#onEditClicked" text="Modifier" styleClass="btn-warning"/>
        <Button fx:id="btnSave" onAction="#saveChanges" text="Enregistrer" visible="false" styleClass="btn-success"/>
        <Button fx:id="btnCancel" onAction="#cancelChanges" text="Annuler" visible="false" styleClass="btn-danger"/>
    </HBox>
</VBox>
