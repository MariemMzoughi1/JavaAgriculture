<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.Controllers.VoirParcelleController"
            style="-fx-background-color: linear-gradient(to bottom right, #eef2f3, #ffffff); -fx-border-radius: 15; -fx-background-radius: 15;"
            prefWidth="400" prefHeight="500">

    <VBox spacing="20" alignment="TOP_CENTER" style="-fx-padding: 20;">

        <!-- Titre -->
        <Label text="📋 Détails de la Parcelle"
               style="-fx-font-size: 22px; -fx-text-fill: #2c3e50; -fx-font-weight: bold;" />

        <!-- Contenu -->
        <ScrollPane fitToWidth="true" prefHeight="360" style="-fx-background-color: transparent;">
            <content>
                <VBox fx:id="infoBox" spacing="15" style="-fx-padding: 10; -fx-background-color: white; -fx-border-radius: 10; -fx-background-radius: 10;">
                    <!-- les labels seront ajoutés dynamiquement -->
                </VBox>
            </content>
        </ScrollPane>

        <!-- Bouton -->
        <Button text="Fermer"
                onAction="#fermer"
                style="-fx-background-color: linear-gradient(to right, #ff416c, #ff4b2b); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20;"
                prefWidth="150" prefHeight="40" />
    </VBox>
</AnchorPane>
